# Copy to server/.env and fill in. Everything except the three secrets has a sensible default.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Local: `docker compose up -d mongo` (Atlas Local image — supports Vector Search).
# Cloud: your MongoDB Atlas connection string (free M0 tier supports Vector Search).
MONGODB_URI=mongodb://localhost:27017/mailgic?directConnection=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- AI provider: pick ONE of the two blocks below ----

# Option A: Google Gemini (free tier, key from https://aistudio.google.com/apikey)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=AIza...your-gemini-key
OPENAI_CHAT_MODEL=gemini-flash-latest
OPENAI_FAST_MODEL=gemini-flash-lite-latest
OPENAI_FALLBACK_MODEL=gemini-flash-lite-latest
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Option B: OpenAI (paid, key from https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Check the provider works before starting the app:  npm --prefix server run ai:check

DAILY_AI_REQUEST_LIMIT=50

# Optional. Without it, password-reset emails are printed to the server log in development.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Mailgic-AI <no-reply@yourdomain.com>"
